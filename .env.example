COMPOSE_PROJECT_NAME=support-copilot
APP_PORT=5020
PUBLIC_BASE_PATH=/demo/support-copilot/

APP_ENV=local
APP_KEY=
APP_DEBUG=true
LOG_LEVEL=debug

DB_DATABASE=support_copilot
DB_USERNAME=support_copilot
DB_PASSWORD=support_copilot

REDIS_PASSWORD=

SESSION_COOKIE=support_copilot_admin
SESSION_PATH=/demo/support-copilot/
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=sangcnt.online,127.0.0.1:5020,localhost

DEMO_SESSION_COOKIE=support_copilot_demo
DEMO_SESSION_LIFETIME_DAYS=7
DEMO_SESSION_COOKIE_PATH=/demo/support-copilot/
DEMO_SESSION_SECURE_COOKIE=false
DEMO_SESSION_SAME_SITE=lax

# Optional: used by `php artisan db:seed` to create the first admin.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

DOCUMENT_DISK=documents
DOCUMENT_MAX_KILOBYTES=10240

AI_APP_ENVIRONMENT=local
AI_APP_PORT=8030
AI_LOG_LEVEL=INFO
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.6-terra
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
AI_EMBEDDING_BATCH_SIZE=32
AI_RETRIEVAL_TOP_K=5
AI_RETRIEVAL_MIN_SCORE=0.2
AI_SERVICE_TIMEOUT=30
AI_SERVICE_STREAM_TIMEOUT=120
