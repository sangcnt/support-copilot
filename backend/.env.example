APP_NAME="Support Copilot"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:5020

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=support_copilot
DB_USERNAME=support_copilot
DB_PASSWORD=support_copilot

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/demo/support-copilot/
SESSION_DOMAIN=null
SESSION_COOKIE=support_copilot_admin
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=sangcnt.online,127.0.0.1:5020,localhost

DEMO_SESSION_COOKIE=support_copilot_demo
DEMO_SESSION_LIFETIME_DAYS=7
DEMO_SESSION_COOKIE_PATH=/demo/support-copilot/
DEMO_SESSION_SECURE_COOKIE=false
DEMO_SESSION_SAME_SITE=lax

# Optional: used by `php artisan db:seed` to create the first admin.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

DOCUMENT_DISK=documents
DOCUMENT_MAX_KILOBYTES=10240

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AI_SERVICE_URL=http://ai-service:8000
